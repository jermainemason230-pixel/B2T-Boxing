# Resend — transactional email for contact form submissions
# Sign up at https://resend.com, create an API key, verify your sending domain.
RESEND_API_KEY=

# Inbox that receives free-trial / contact-form submissions.
OWNER_EMAIL=

# Stripe Payment Link for $150 monthly dues.
# Create at https://dashboard.stripe.com/payment-links — set as recurring, $150/mo.
# If unset, the /pay page falls back to a "coming soon" message.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Public base URL — used for canonical tags, OG metadata, and sitemap.
# Production: https://b2tboxing.com   Dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
